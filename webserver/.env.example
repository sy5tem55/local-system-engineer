# webserver/.env.example → copy to .env and adjust

# Port Nginx listens on (host side)
WEB_PORT=8080

# FastAPI port on the host (proxied at /api/)
FASTAPI_PORT=8000

# Vite dev server port (proxied at /)
# For production builds, comment out the vite upstream in nginx.conf
# and serve from a static volume mount instead
VITE_PORT=5173
