{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-system-engineer.invalid/schemas/traum-isolation-attestation-v1.schema.json",
  "title": "TRAUM evaluation isolation attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "condition",
    "store_url",
    "gateway_url",
    "filesystem_root",
    "isolated",
    "disposable",
    "production_data",
    "production_writes",
    "auto_apply_enabled"
  ],
  "properties": {
    "schema_version": {"const": "traum.eval.isolation.v1"},
    "condition": {"enum": ["A", "B"]},
    "store_url": {"type": "string", "format": "uri"},
    "gateway_url": {"type": "string", "format": "uri"},
    "filesystem_root": {"type": "string", "minLength": 1},
    "isolated": {"const": true},
    "disposable": {"const": true},
    "production_data": {"const": false},
    "production_writes": {"const": false},
    "auto_apply_enabled": {"const": false}
  }
}
