{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-system-engineer.invalid/schemas/traum-eval-spec-v2.schema.json",
  "title": "TRAUM A/B evaluation immutable input specification v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "min_elapsed_seconds", "trial_seeds", "pins", "conditions"],
  "properties": {
    "schema_version": {"const": "traum.eval.spec.v2"},
    "min_elapsed_seconds": {"type": "integer", "minimum": 3600},
    "trial_seeds": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "prompt", "tool_schema", "retriever", "embedding", "dataset"],
      "properties": {
        "model": {"$ref": "#/$defs/digestPin"},
        "embedding": {"$ref": "#/$defs/digestPin"},
        "prompt": {"$ref": "#/$defs/filePin"},
        "tool_schema": {"$ref": "#/$defs/filePin"},
        "retriever": {"$ref": "#/$defs/filePin"},
        "dataset": {"$ref": "#/$defs/filePin"}
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B"],
      "properties": {
        "A": {"$ref": "#/$defs/condition"},
        "B": {"$ref": "#/$defs/condition"}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suite_noninferiority_margin": {"type": "number", "minimum": 0},
        "recall_noninferiority_margin": {"type": "number", "minimum": 0},
        "mrr_noninferiority_margin": {"type": "number", "minimum": 0},
        "minimum_tool_call_reduction": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_wrong_hit_mean_increase": {"type": "number", "minimum": 0},
        "maximum_wrong_hit_per_trial_increase": {"type": "integer", "minimum": 0},
        "maximum_wrong_hit_total_increase": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"},
    "digestPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "filePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_url", "gateway_url", "filesystem_root", "attestation"],
      "properties": {
        "store_url": {"type": "string", "format": "uri"},
        "gateway_url": {"type": "string", "format": "uri"},
        "filesystem_root": {"type": "string", "minLength": 1},
        "attestation": {"type": "string", "minLength": 1}
      }
    }
  }
}
