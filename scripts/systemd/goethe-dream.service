[Unit]
Description=Goethe TRAUM nightly dream cycle
Documentation=file:/home/sy5/projects/local-system-engineer/docs/07-operations-runbook.md
After=network-online.target docker.service ollama.service
Wants=network-online.target
ConditionFileIsExecutable=/home/sy5/projects/local-system-engineer/tools/run-dream-cycle.sh

[Service]
Type=oneshot
User=sy5
Group=sy5
WorkingDirectory=/var/lib/lse-dream
StateDirectory=lse-dream
UMask=0077
Environment=HOME=/home/sy5
Environment=PYTHONUNBUFFERED=1
Environment=GOETHE_ES_URL=http://127.0.0.1:9200
Environment=GOETHE_OLLAMA_URL=http://127.0.0.1:11434
Environment=GOETHE_EMBED_MODEL=qwen3-embedding:0.6b
EnvironmentFile=-/etc/lse/goethe-dream.env
ExecStart=/usr/bin/timeout --foreground 45m /home/sy5/projects/local-system-engineer/tools/run-dream-cycle.sh
TimeoutStartSec=46min
Restart=no

# The runner writes only reports/locks plus manifest.db. Corpus session files
# are protected by the runner's before/after invariant check.
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/sy5/projects/local-system-engineer /opt/local-se/tasks.db /opt/local-se/agent_commands.log
ReadWritePaths=/opt/local-se/dreams /opt/local-se/episodes /var/lib/lse-dream
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
