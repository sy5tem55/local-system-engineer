# /opt/local-se/goethe-mcp.env  (chmod 600 - contains secrets)
# Loaded by goethe-mcp.service. Copy to /opt/local-se/goethe-mcp.env and edit.

# Caller auth for the HTTP endpoint. REQUIRED for any non-localhost-trusted setup.
# Generate with:  openssl rand -hex 16
# NOTE: if llama-ui cannot send an Authorization header to the MCP server, leave
# this empty to fall back to localhost-only trust (any local process can then call
# it - acceptable only on a single-user box). See deploy notes.
GOETHE_MCP_TOKEN=

# Browser origin allowed for direct CORS (your llama-ui URL). Lets you skip
# llama.cpp's CORS proxy entirely.
GOETHE_MCP_CORS_ORIGIN=http://127.0.0.1:8080

# ---- Valve overrides (env name = GOETHE_<VALVE>) ----
GOETHE_COMMAND_TIMEOUT=200
# GOETHE_DEFAULT_WORKING_DIR=/home/sy5
# GOETHE_LLAMA_SERVER_URL=http://localhost:8080
# GOETHE_SEARXNG_URL=http://localhost:8088/search
# GOETHE_ES_URL=http://127.0.0.1:9200
# GOETHE_OLLAMA_URL=http://127.0.0.1:11434
# GOETHE_PFSENSE_URL=https://pfsense.home.arpa
# GOETHE_PFSENSE_API_KEY=
# GOETHE_HERMES_API_URL=http://192.168.5.41:8642
# GOETHE_HERMES_API_KEY=
# GOETHE_TASKS_DB=/opt/local-se/tasks.db
