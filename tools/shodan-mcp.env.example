# Shodan MCP server — valve defaults.
# Copy to shodan-mcp.env (same dir) and fill in. Keep shodan-mcp.env local-only;
# NEVER commit a real key. The server also reads plain env vars; the env file is
# just convenience for start-shodan.sh.

# REQUIRED — Shodan API key (free account: https://account.shodan.io -> API tab)
SHODAN_API_KEY=

# MCP server bind address/port (default shown; keep loopback unless you know why)
SHODAN_MCP_HOST=127.0.0.1
SHODAN_MCP_PORT=9702

# Bearer token for the /mcp endpoint (empty = no auth, relies on loopback only)
SHODAN_MCP_TOKEN=

# CORS origin for browser MCP clients (default = *)
SHODAN_MCP_CORS_ORIGIN=*

# Upstream API base (default shown; override only for mocks/tests)
SHODAN_API_BASE=https://api.shodan.io
